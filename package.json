{
  "name": "task-board",
  "private": "true",
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm --workspace frontend run dev",
    "dev:api": "npm --workspace backend run start:dev",
    "build": "npm run build --workspace frontend && npm run build --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
